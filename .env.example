# --- LLM (OpenAI) ---
OPENAI_API_KEY=
# Optional: send model calls to another OpenAI-compatible endpoint (e.g. a local proxy for dev
# testing). Leave empty to use the official OpenAI API.
LLM_BASE_URL=
LLM_API_KEY=
# On networks with a system HTTP proxy, keep local traffic (the endpoint above, the sandbox) direct
NO_PROXY=localhost,127.0.0.1,::1
AGENT_MODEL=
VERIFIER_MODEL=
# GPT-5-family reasoning effort (none|minimal|low|medium|high); leave empty for models without it
REASONING_EFFORT=low
# $ per 1M tokens, for cost tracking (fill from OpenAI pricing page)
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=

# --- Sandbox ERP ---
ACME_ERP_URL=http://localhost:8000
ACME_ERP_USER=agent
ACME_ERP_PASSWORD=acme-demo-123

# --- Runtime ---
HEADLESS=0
MAX_STEPS=150
MAX_COST_USD=3.00
DEBUG_LLM=0
